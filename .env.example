# Postgres
DATABASE_URL=postgres://freebird:freebird@db:5432/freebird

# Publieke URL van de app (voor bunq-callbacks en links)
APP_URL=https://boekhouding.jouwbedrijf.nl

# Login: genereer met `npm run hash-password -- 'jouw-wachtwoord'`
ADMIN_PASSWORD_HASH_B64=
# Willekeurige string van minimaal 32 tekens: `openssl rand -base64 48`
SESSION_SECRET=

# 32 bytes, base64: `openssl rand -base64 32`. Versleutelt API keys en wachtwoorden in de database.
# Kwijt = alle opgeslagen secrets opnieuw invoeren. Bewaar hem in je wachtwoordmanager.
APP_ENCRYPTION_KEY=

# Bestanden (PDF's, bonnen, UBL)
DATA_DIR=/data

# DeepSeek voor AI: bonnen uitlezen, boekvoorstellen, controles en vragen
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Toegang voor Claude Code tot /api/agent (facturen uploaden en boeken). Leeg = uit.
# Minimaal 32 tekens: `openssl rand -hex 32`
AGENT_API_TOKEN=

# bunq: "production" of "sandbox"
BUNQ_ENV=production
# Controleer bron-IP van bunq-callbacks (zet op false als je achter een proxy zit die X-Forwarded-For niet doorgeeft)
BUNQ_CALLBACK_IP_CHECK=true
